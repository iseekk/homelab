# Shared
TZ=UTC

# Tailscale
TS_AUTHKEY=tskey-auth-...
TS_STATE_DIR=/var/lib/tailscale

# Vaultwarden
DOMAIN=https://homelab.your-tailnet.ts.net
INVITATIONS_ALLOWED=false
SIGNUPS_ALLOWED=true

# Backup
# Required, min. 14 characters. Encrypts every backup archive.
ARCHIVE_PASSWORD=
# BACKUP_TIMES="00:15, 04:15, 08:15, 12:15, 16:15, 20:15"

# Local storage retention in days (S3: use bucket lifecycle rules, see README)
# RETENTION_DAILY_DAYS=7
# RETENTION_WEEKLY_DAYS=35
# RETENTION_MONTHLY_DAYS=365

# AWS S3 (leave S3_BUCKET empty to use local storage)
S3_BUCKET=
# S3_PREFIX=vaultwarden
# S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring (optional — https://healthchecks.io)
HEALTHCHECKS_PING_URL=
